{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "Node",
    "target": "ES2021",
    "lib": ["ES2021"],
    "outDir": "dist-extension",
    "rootDir": "src",
    "sourceMap": true,
    "declaration": false,
    "types": ["node", "vscode"]
  },
  "include": ["src/**/*.ts"]
}
