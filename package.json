{
  "name": "flow-manuscript",
  "displayName": "Flow Manuscript",
  "description": "Plan and write novels as a scene flow diagram with a rich Markdown editor.",
  "version": "0.1.1",
  "publisher": "local",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/wodutoit/flow-manuscript"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "main": "./dist-extension/extension/extension.js",
  "activationEvents": [
    "onView:flowManuscript.tree",
    "workspaceContains:outline.flow.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "flowManuscript.newManuscript",
        "title": "Flow Manuscript: New Manuscript…"
      },
      {
        "command": "flowManuscript.importManuscript",
        "title": "Flow Manuscript: Import Existing Manuscript…"
      },
      {
        "command": "flowManuscript.openDiagram",
        "title": "Flow Manuscript: Open Diagram",
        "icon": "$(type-hierarchy)"
      },
      {
        "command": "flowManuscript.addCharacter",
        "title": "Add Character",
        "icon": "$(add)"
      },
      {
        "command": "flowManuscript.addPlace",
        "title": "Add Place",
        "icon": "$(add)"
      },
      {
        "command": "flowManuscript.addAct",
        "title": "Add Act",
        "icon": "$(add)"
      },
      {
        "command": "flowManuscript.addSceneToAct",
        "title": "Add Scene to Act",
        "icon": "$(add)"
      },
      {
        "command": "flowManuscript.moveActUp",
        "title": "Move Act Up",
        "icon": "$(arrow-up)"
      },
      {
        "command": "flowManuscript.moveActDown",
        "title": "Move Act Down",
        "icon": "$(arrow-down)"
      },
      {
        "command": "flowManuscript.renameAct",
        "title": "Rename Act",
        "icon": "$(edit)"
      },
      {
        "command": "flowManuscript.deleteAct",
        "title": "Delete Act",
        "icon": "$(trash)"
      },
      {
        "command": "flowManuscript.deleteNode",
        "title": "Delete",
        "icon": "$(trash)"
      },
      {
        "command": "flowManuscript.moveSceneToAct",
        "title": "Move to Act…",
        "icon": "$(arrow-right)"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "flowManuscript",
          "title": "Flow Manuscript",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "flowManuscript": [
        {
          "id": "flowManuscript.tree",
          "name": "Manuscript"
        }
      ]
    },
    "menus": {
      "view/title": [
        {
          "command": "flowManuscript.openDiagram",
          "when": "view == flowManuscript.tree",
          "group": "navigation"
        }
      ],
      "view/item/context": [
        {
          "command": "flowManuscript.addAct",
          "when": "view == flowManuscript.tree && viewItem == group:scene",
          "group": "inline"
        },
        {
          "command": "flowManuscript.addCharacter",
          "when": "view == flowManuscript.tree && viewItem == group:character",
          "group": "inline"
        },
        {
          "command": "flowManuscript.addPlace",
          "when": "view == flowManuscript.tree && viewItem == group:place",
          "group": "inline"
        },
        {
          "command": "flowManuscript.addSceneToAct",
          "when": "view == flowManuscript.tree && viewItem == act",
          "group": "inline@1"
        },
        {
          "command": "flowManuscript.moveActUp",
          "when": "view == flowManuscript.tree && viewItem == act",
          "group": "inline@2"
        },
        {
          "command": "flowManuscript.moveActDown",
          "when": "view == flowManuscript.tree && viewItem == act",
          "group": "inline@3"
        },
        {
          "command": "flowManuscript.deleteAct",
          "when": "view == flowManuscript.tree && viewItem == act",
          "group": "inline@4"
        },
        {
          "command": "flowManuscript.renameAct",
          "when": "view == flowManuscript.tree && viewItem == act",
          "group": "1_modify"
        },
        {
          "command": "flowManuscript.deleteAct",
          "when": "view == flowManuscript.tree && viewItem == act",
          "group": "1_modify"
        },
        {
          "command": "flowManuscript.moveSceneToAct",
          "when": "view == flowManuscript.tree && viewItem == node:scene",
          "group": "inline@1"
        },
        {
          "command": "flowManuscript.deleteNode",
          "when": "view == flowManuscript.tree && viewItem == node:scene",
          "group": "inline@2"
        },
        {
          "command": "flowManuscript.deleteNode",
          "when": "view == flowManuscript.tree && viewItem == node:character",
          "group": "inline"
        },
        {
          "command": "flowManuscript.deleteNode",
          "when": "view == flowManuscript.tree && viewItem == node:place",
          "group": "inline"
        },
        {
          "command": "flowManuscript.moveSceneToAct",
          "when": "view == flowManuscript.tree && viewItem == node:scene",
          "group": "1_modify"
        },
        {
          "command": "flowManuscript.deleteNode",
          "when": "view == flowManuscript.tree && (viewItem == node:scene || viewItem == node:character || viewItem == node:place)",
          "group": "1_modify"
        }
      ]
    }
  },
  "scripts": {
    "copy-dict": "node scripts/copy-dictionaries.js",
    "build:extension": "node scripts/build-extension.js",
    "typecheck:extension": "tsc -p tsconfig.extension.json --noEmit",
    "build:diagram": "vite build --config webview-diagram/vite.config.ts",
    "build:editor": "vite build --config webview-editor/vite.config.ts",
    "build": "npm run copy-dict && npm run build:extension && npm run build:diagram && npm run build:editor",
    "watch:extension": "node scripts/build-extension.js --watch",
    "package": "vsce package",
    "vscode:prepublish": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/vscode": "^1.90.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vscode/vsce": "^2.24.0",
    "typescript": "^5.4.0",
    "vite": "^5.2.0"
  },
  "dependencies": {
    "@tiptap/extension-placeholder": "^2.4.0",
    "@tiptap/extension-underline": "^2.4.0",
    "@tiptap/react": "^2.4.0",
    "@tiptap/starter-kit": "^2.4.0",
    "dictionary-en": "^4.0.0",
    "dictionary-en-gb": "^3.0.0",
    "gray-matter": "^4.0.3",
    "nspell": "^2.1.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "reactflow": "^11.11.0",
    "tiptap-markdown": "^0.8.10"
  }
}
